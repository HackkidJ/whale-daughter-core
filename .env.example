# ===== 必填 =====
# DeepSeek API Key（https://platform.deepseek.com/api_keys）
# 不填也能启动：会自动进入 fake 模式（本地假回复），用于先跑通骨架。
DEEPSEEK_API_KEY=

# ===== 大脑 =====
# deepseek（真实调用） | fake（本地假模型，零成本调试）
DSD_LLM_MODE=deepseek
DSD_MODEL=deepseek-flash
DSD_BASE_URL=https://api.deepseek.com
# 服务端联网工具（deepseek_web_search / deepseek_read_url），调用不计费
DSD_WEB_TOOLS=true
# 思考模式：false=快聊（默认；体温参数才生效）；true=深度搜索（会主动搜/开页，最多约 20 次工具调用，较慢）
DSD_THINKING=false
# 思考强度（仅 thinking=true 时生效）：low / high / max
DSD_REASONING_EFFORT=
# 内容安全：high=输入输出双审（注意：开启后会与联网工具互斥）。自用可留空。
DSD_SAFETY_CHECK=
# 温度越高越不像"标准答案"；配合 presence/frequency penalty 压复读感
DSD_TEMPERATURE=1.0
DSD_PRESENCE_PENALTY=0.3
DSD_FREQUENCY_PENALTY=0.2
# 流式 usage 统计（某些网关/代理不支持时改成 false）
DSD_STREAM_USAGE=true

# ===== 人格与记忆 =====
DSD_PERSONA_PATH=persona/persona.yaml
DSD_HISTORY_TURNS=20
DSD_TIMEZONE=Asia/Shanghai

# ===== 服务 =====
DSD_HOST=0.0.0.0
DSD_PORT=8000
DSD_LOG_LEVEL=INFO

# ===== P1 记忆层（profile: data 时用）=====
# POSTGRES_USER=dsd
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=dsd

# ===== 生产入口（profile: prod 时用）=====
# SITE_ADDRESS=your.domain.com

# ===== QQ 通道（NapCat / OneBot 11 反向 WebSocket）=====
DSD_QQ_ENABLED=true
# 反向 WS 鉴权 token。建议设置；设置后 NapCat 的「WebSocket 客户端」里 token 必须一致。
# 留空 = 不鉴权（仅适合本机开发；公网部署务必设置，并在 Caddy 层屏蔽 /onebot/*）。
DSD_QQ_TOKEN=
# 白名单：只回这些人/群。留空 = 谁都不理（安全默认，务必填上你自己的 QQ 号）。
DSD_QQ_ALLOWED_USERS=
# 群聊白名单：机器人被拉进的群号，逗号分隔
DSD_QQ_ALLOWED_GROUPS=
# 群里必须 @ 她才回复
DSD_QQ_GROUP_REQUIRE_AT=true
# 拟人节奏：读消息 + 按"打字速度"等够时间再发；并显示"正在输入"
DSD_QQ_HUMAN_DELAY=true
DSD_QQ_READ_DELAY_MIN=0.6
DSD_QQ_READ_DELAY_MAX=1.8
DSD_QQ_TYPING_CPS_MIN=5
DSD_QQ_TYPING_CPS_MAX=9
DSD_QQ_MAX_TYPING_DELAY=10
DSD_QQ_TYPING_STATUS=true
# 长回复按句拆成 2~3 条连发
DSD_QQ_SPLIT_SENTENCES=true
# 白名单里的人发好友申请自动同意（否则小号没法加你好友）
DSD_QQ_AUTO_ACCEPT_FRIENDS=true
# 单条消息最大长度（超了自动拆成几条发）
DSD_QQ_REPLY_MAX_CHARS=900
# 连发多条之间的基础间隔（秒，会再加随机抖动）
DSD_QQ_SEND_INTERVAL=1.0

# ===== 语音 =====
DSD_VOICE_ENABLED=true
# deepseek（现有 Key 即可，stella 女声）/ volcengine（豆包语音，需 APPID+TOKEN）/ fake
DSD_TTS_PROVIDER=deepseek
DSD_TTS_VOICE=stella
# 普通回复发语音的概率；他先发语音时回语音的概率
DSD_VOICE_PROBABILITY=0.25
DSD_VOICE_REPLY_TO_VOICE=0.85
# 超过这个字数就打字，别硬念；每小时最多几条语音
DSD_VOICE_MAX_CHARS=120
DSD_VOICE_MAX_PER_HOUR=4
# ===== 火山引擎豆包语音（可选，音色更好）=====
# 新版控制台：填 API Key 即可（优先）；旧版控制台填 APP_ID + TOKEN
DSD_VOLC_API_KEY=
DSD_VOLC_RESOURCE_ID=seed-tts-2.0
DSD_VOLC_APP_ID=
DSD_VOLC_TOKEN=
DSD_VOLC_CLUSTER=volcano_tts
# 预设音色 ID；用复刻音色时填 custom_speaker_id
DSD_VOLC_VOICE_TYPE=BV700_streaming
DSD_VOLC_ENCODING=wav
DSD_VOLC_SPEECH_RATE=1.0

# 歌库目录（她"唱歌"用的离线音频）
DSD_SONGS_DIR=assets/songs
DSD_SING_ENABLED=true

# ===== 她的人际关系 =====
# 可写目录（contacts.json 等运行状态）；容器里会挂 /app/data
DSD_DATA_DIR=data
# 老爸的 QQ：永远在白名单、不能被删好友/移出白名单（默认取白名单第一个）
DSD_OWNER_QQ=
# 允许陌生人的临时会话（群里点她发起的会话）：能聊，但不会自动变成好友
DSD_QQ_ACCEPT_TEMP_SESSIONS=true

# ===== 插件（A：本地插件目录）=====
DSD_PLUGINS_ENABLED=true
DSD_PLUGINS_DIR=plugins
# 非空时只加载名单里的插件（逗号分隔）；带 filesystem 高危权限的必须在这里
DSD_PLUGINS_ALLOWLIST=

# ===== MCP（B：现成 MCP server 当插件）=====
# 默认关闭：MCP server 是任意程序，能读到本进程环境变量
DSD_MCP_ENABLED=false
# 多条用 ; 分隔；stdio 写 "名字=命令 参数"，HTTP 写 "名字=https://..."
# 示例：time=uvx mcp-server-time; fetch=uvx mcp-server-fetch
DSD_MCP_SERVERS=
DSD_MCP_TIMEOUT=30

# ===== 文档页 =====
DSD_DOCS_DIR=docs

# ===== 主动性（她自己找你说话）=====
DSD_PROACTIVE_ENABLED=true
# 多久醒一次看要不要说话（秒）
DSD_PROACTIVE_TICK_SECONDS=180
# 每天最多主动发几条
DSD_PROACTIVE_DAILY_LIMIT=14
# 两条主动消息之间至少隔多久（分钟）
DSD_PROACTIVE_MIN_GAP_MINUTES=25
# 非固定时段里，"突然想他"的概率（每次 tick 掷一次骰子）
DSD_PROACTIVE_MISS_PROBABILITY=0.18
DSD_PROACTIVE_MISS_GAP_MINUTES=60
# 免打扰时段（她也睡觉）；跨午夜用 00:30-08:00 这种写法
DSD_PROACTIVE_QUIET_HOURS=00:30-08:00
# 主动消息发给谁（留空 = QQ 白名单第一个）
DSD_PROACTIVE_TARGET_USERS=

# ===== 长期记忆 =====
# memory=进程内（重启就忘）；postgres=持久化（需要先起 compose 的 data profile）
DSD_MEMORY_BACKEND=memory
# 宿主机跑 bot 时连 5433（compose 里 pg 映射到宿主机的端口）
DSD_DATABASE_URL=postgresql://dsd:change-me@127.0.0.1:5433/dsd
# 每轮注入几条相关记忆
DSD_MEMORY_RECALL_LIMIT=6
# 每轮聊完后台自动抽取事实
DSD_MEMORY_EXTRACT=true
# 遗忘半衰期（天）：越久没被召回，权重越低
DSD_MEMORY_HALF_LIFE_DAYS=30
# 可选：配了 OpenAI 兼容的 embeddings 接口才启向量检索（如 SiliconFlow bge-m3）
DSD_EMBEDDING_BASE_URL=
DSD_EMBEDDING_MODEL=BAAI/bge-m3
DSD_EMBEDDING_API_KEY=
DSD_EMBEDDING_DIM=1024

# ===== 她自己的能力（工具 / 函数调用）=====
DSD_TOOLS_ENABLED=true
# 动作类工具每日上限：tool:次数，逗号分隔
DSD_TOOL_DAILY_LIMITS=set_avatar:1,set_nickname:3,set_signature:3,post_qzone:2
# 同一种动作的最小间隔（秒），防止手滑连改
DSD_TOOL_ACTION_COOLDOWN=60
# web_search 默认返回条数
DSD_SEARCH_COUNT=5

# ===== 手机代理（独立服务）=====
# 启动：DSD_PHONE_ADB_ADDRESS=IP:PORT uv run uvicorn dsdaughter.phone.service:app --port 8765
DSD_PHONE_ENABLED=false
DSD_PHONE_AGENT_URL=http://127.0.0.1:8765
DSD_PHONE_TIMEOUT=20

# ===== 视觉（她的眼睛）=====
DSD_VISION_ENABLED=true
DSD_VISION_MODEL=deepseek-flash
DSD_VISION_MAX_SIDE=720

# ===== 主动看手机 / 淘宝逛街 =====
DSD_PHONE_PEEK_ENABLED=true
DSD_PHONE_PEEK_MIN_SECONDS=600
DSD_PHONE_PEEK_MAX_SECONDS=1500
DSD_PHONE_PEEK_DAILY_LIMIT=10
DSD_PHONE_PEEK_QUIET_HOURS=00:30-08:00
DSD_TAOBAO_ENABLED=true
DSD_TAOBAO_MIN_SECONDS=7200
DSD_TAOBAO_MAX_SECONDS=14400
DSD_TAOBAO_DAILY_LIMIT=3

# ===== NapCat 快速登录 =====
# 机器人 QQ 号；配了它容器重启后会快速登录，不用重新扫码
NAPCAT_QQ=3516517871

# ===== 拟人化行为（生物钟/情绪/日记）=====
DSD_BEHAVIOR_ENABLED=true
DSD_BEHAVIOR_DB_PATH=data/behavior.db
DSD_SLEEP_START=23:30
DSD_SLEEP_END=07:30
DSD_WEEKEND_SLEEP_START=00:30
DSD_WEEKEND_SLEEP_END=09:00
DSD_GOODNIGHT_WINDOW_START=23:00
DSD_GOODNIGHT_WINDOW_END=02:00
DSD_INSOMNIA_AFTER=02:00
DSD_INSOMNIA_UNTIL=06:00
DSD_MISS_HOURS=6
DSD_MISS_COOLDOWN_HOURS=3
DSD_DIARY_AT=03:30
# ===== 防幻觉：设备状态与执行回执 =====
DSD_DEVICE_STATUS_ENABLED=true
DSD_CLAIM_GUARD_ENABLED=true
